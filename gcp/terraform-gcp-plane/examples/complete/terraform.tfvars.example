# Copy to terraform.tfvars. Set the project, region, name and domain, pick how traffic reaches Plane, and uncomment
# anything else you want to change. Commented values are the defaults. For objects, set only the fields you change.

project_id = "my-plane-project" # a project of its own, billing linked
region     = "us-central1"

name   = "plane"             # never change after install
domain = "plane.example.com" # never change after install

################################################################################
# How traffic reaches Plane: pick ONE block and uncomment it.
# The module configures no DNS. After the apply, create the records shown by:  terraform output dns_records
################################################################################

# Path A: automated. The module installs Traefik on a reserved static IP, Plane's routes and the certificates.

# A.1  Let's Encrypt (Plane must be public on port 80; the certificate is issued once your DNS record exists)
# ingress    = { mode = "automated" }
# acme_email = "ops@example.com"
# email      = { certificate_secret = "projects/my-plane-project/secrets/plane-mail-tls" } # optional; else self-signed

# A.2  Your own certificates, stored in Secret Manager in project_id before the apply (JSON keys "tls.crt" and "tls.key")
# ingress = { mode = "automated", tls_certificate_secret = "projects/my-plane-project/secrets/plane-web-tls" }
# email   = { certificate_secret = "projects/my-plane-project/secrets/plane-mail-tls" } # optional; same secret if it covers both names

# Path B: bring your own (default). Nothing to set here. After the apply: install your ingress controller,
# apply Plane's routes, add your certificate and DNS records.

################################################################################
# Everything else (defaults)
################################################################################

# labels      = {}
# zones       = []   # GKE picks three zones of region
# enable_apis = true # set false if your organisation enables APIs centrally

# ingress = {
#   mode                   = "none"            # automated (path A) | none (path B)
#   allowed_cidrs          = ["0.0.0.0/0"]     # path A: who can reach Plane
#   scheme                 = "internet-facing" # path A: or internal (not with Let's Encrypt); set at install
#   tls_certificate_secret = null              # path A: your web certificate (A.2)
# }
# acme_server     = "https://acme-v02.api.letsencrypt.org/directory" # tests: acme-staging-v02
# tls_secret_name = "plane-tls"

# master_authorized_networks = ["0.0.0.0/0"] # who can reach the GKE API
# cluster_admin_members      = []            # e.g. ["group:platform@example.com"]

