# Unset by default:
# route53_zone_id = "Z0123456789ABCDEFGHIJ" # Route 53 zone: automatic DNS + certificate
# acme_email      = "ops@example.com"       # Let's Encrypt certificate (needed with route53_zone_id)

# Examples
#
# Domain in Route 53:
#   route53_zone_id = "Z0123456789ABCDEFGHIJ"
#   acme_email      = "ops@example.com"
#
# Domain elsewhere (Cloudflare, ...): set acme_email, then CNAME the domain to the load_balancer_dns_name output.
#
# Test install you will destroy:
#   acme_server          = "https://acme-staging-v02.api.letsencrypt.org/directory"
#   postgres             = { deletion_protection = false }
#   bucket_force_destroy = true
#
# More nodes:
#   node_group = { desired_size = 3 }
