region = "us-east-1"
name   = "plane"
domain = "plane.example.com"

# Route 53 public zone containing the domain: the module writes the DNS record. Remove it to create a CNAME to the
# load_balancer_dns_name output yourself; with acme_email kept, the certificate then comes from HTTP-01.
route53_zone_id = "Z0123456789ABCDEFGHIJ"
acme_email      = "ops@example.com" # remove to provide your own certificate

# vpc_cidr = "10.60.0.0/16"  # change if it overlaps a network you will peer or VPN with

admin_cidrs = ["203.0.113.10/32"]

# Plane's email service (inbound email to work items) on its own NLB, ports 25/465/587. Off when unset.
# email_smtp_domain = "intake.example.com"

# Amazon OpenSearch Service for search (off by default). After the first install, create the indexes once:
# see "Search (OpenSearch)" in the module README.
# enable_opensearch = true

# Test installs you plan to destroy only:
# postgres_deletion_protection = false
# bucket_force_destroy         = true
