# Copy to terraform.tfvars. Set name and domain, pick how traffic reaches Plane, and uncomment anything else you want
# to change. Commented values are the defaults. For objects, set only the fields you change.

name   = "plane"             # never change after install
domain = "plane.example.com" # never change after install

# deployment_mode = "eks"   # or "docker": one EC2 instance with Docker Compose (see "Docker mode" below)

################################################################################
# How traffic reaches Plane: pick ONE block and uncomment it.
# The module configures no DNS. After the apply, create the records shown by:  terraform output dns_records
################################################################################

# Path A: automated. The module installs Traefik, Plane's routes and the certificates.

# A.1  Let's Encrypt (Plane must be public on port 80; the certificate is issued once your DNS record exists)
# ingress    = { mode = "automated" }
# acme_email = "ops@example.com"
# email      = { certificate_secret_arn = "arn:aws:secretsmanager:...:secret:plane/mail-tls" } # optional; else self-signed

# A.2  Your own certificates, stored in Secrets Manager before the apply (JSON keys "tls.crt" and "tls.key")
# ingress = { mode = "automated", tls_certificate_secret_arn = "arn:aws:secretsmanager:...:secret:plane/web-tls" }
# email   = { certificate_secret_arn = "arn:aws:secretsmanager:...:secret:plane/mail-tls" } # optional; same ARN if it covers both names

# Path B: bring your own (EKS default). Nothing to set here. After the apply: install your ingress controller,
# apply Plane's routes, add your certificate and DNS records.

################################################################################
# Docker mode: one EC2 instance runs Plane's Docker Compose stack (bundled Postgres, Valkey, RabbitMQ, MinIO).
# ingress defaults to path A here: set acme_email (A.1) or ingress.tls_certificate_secret_arn (A.2), or
# ingress = { mode = "none" } for path B (private instance, plain HTTP on :80 behind your load balancer).
# The EKS-only settings below (cluster, node_group, postgres, redis, rabbitmq, opensearch, chart_*) are ignored.
################################################################################

# deployment_mode = "docker"
# acme_email      = "ops@example.com"
# docker = {
#   compose_assets_url    = "s3://my-bucket/plane-assets" # until Plane publishes them (default: Plane's URL)
#   compose_assets_sha256 = { "docker-compose.yml" = "<sha256>", "variables.env" = "<sha256>" }
# }

################################################################################
# Everything else (defaults)
################################################################################

