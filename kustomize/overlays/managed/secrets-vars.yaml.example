# Example secrets configuration file for the managed overlay.
#
# Copy this file to secrets-vars.yaml and update with your actual values:
#   cp secrets-vars.yaml.example secrets-vars.yaml
#
# WARNING: secrets-vars.yaml contains sensitive data and should NOT be committed to git!
# It is already included in .gitignore.
#
# This overlay connects to external managed services: RDS (Postgres), ElastiCache (Redis),
# Amazon MQ (RabbitMQ-compatible AMQP), S3, and Amazon OpenSearch Service.

apiVersion: v1
kind: Secret
metadata:
  name: overlay-secret-vars
  annotations:
    config.kubernetes.io/local-config: "true"
type: Opaque
stringData:
  # ── Database (AWS RDS) ────────────────────────────────────────────────────────
  # Required when component static-db-url is enabled (default in this overlay).
  DATABASE_URL: "postgresql://<db-user>:<db-password>@your-rds-instance.us-east-1.rds.amazonaws.com:5432/plane"

  # ── Message broker (Amazon MQ) ────────────────────────────────────────────────
  # AmazonMQ uses port 5671 (AMQP over TLS) by default
  AMQP_URL: "amqps://<mq-user>:<mq-password>@your-amazonmq.mq.us-east-1.amazonaws.com:5671/"

  # ── Cache (Amazon ElastiCache) ────────────────────────────────────────────────
  REDIS_URL: "redis://your-cluster.cache.amazonaws.com:6379/0"

  # ── Object storage (AWS S3) ───────────────────────────────────────────────────
  # Required when component s3-static-credentials is enabled (default in this overlay).
  AWS_ACCESS_KEY_ID: "<your-access-key-id>"
  AWS_SECRET_ACCESS_KEY: "<your-secret-access-key>"
  # Leave empty to use the default AWS S3 endpoint for the configured region
  AWS_S3_ENDPOINT_URL: ""
  AWS_S3_BUCKET_NAME: "<your-plane-bucket>"
  AWS_REGION: "us-east-1"
  USE_MINIO: "0"
  # Maximum file upload size in bytes (5242880 = 5MB)
  FILE_SIZE_LIMIT: "5242880"

  # ── OpenSearch (Amazon OpenSearch Service) ────────────────────────────────────
  OPENSEARCH_ENABLED: "1"
  OPENSEARCH_URL: "https://your-domain.us-east-1.es.amazonaws.com"

  # ── Application secrets ───────────────────────────────────────────────────────
  # Generate new random values before deploying:
  #   openssl rand -hex 32
  SECRET_KEY: "GENERATE-A-RANDOM-64-HEX-STRING"
  AES_SECRET_KEY: "GENERATE-A-RANDOM-32-CHARACTER-STRING"
  LIVE_SERVER_SECRET_KEY: "GENERATE-A-RANDOM-64-HEX-STRING"

  # ── Argus (content security / compliance scanning) ──────────────────────────
  # All five keys below are REQUIRED whenever the argus component is enabled:
  # they are replacement sources, so a missing key fails the whole overlay
  # render, not just argus.
  #
  # Argus creates its own `argus` schema inside the Plane database AND reads
  # Plane's content tables (work items, pages, comments) read-only. This DSN
  # MUST therefore point at exactly the same database as DATABASE_URL above —
  # if it points elsewhere, scans silently find nothing.
  #
  # NOTE: Argus has no AWS Secrets Manager support (no RDS_SECRET_ARN
  # equivalent), so this is the one workload in this overlay that needs a static
  # RDS credential in plaintext. Nothing keeps it in sync: on an RDS password
  # rotation every other workload follows RDS_SECRET_ARN while argus keeps this
  # stale DSN and CrashLoops on auth until you update it by hand.
  ARGUS_DATABASE_URL: "postgresql://<db-user>:<db-password>@your-rds-instance.us-east-1.rds.amazonaws.com:5432/plane"
  # Optional read replica for content scans (empty falls back to ARGUS_DATABASE_URL)
  ARGUS_CONTENT_DATABASE_URL: ""
  # REQUIRED — HKDF master key for finding fingerprints (min 32 chars).
  # Generate: openssl rand -hex 32
  # Left empty deliberately so startup fails closed: Argus only rejects a short
  # value or one of its known placeholder strings, so a plausible-looking
  # placeholder would boot and HMAC every fingerprint under a key that is public
  # in this repo. Rotating it later invalidates all stored fingerprints/triage.
  ARGUS_FINGERPRINT_SECRET: ""
  ARGUS_INTERNAL_SECRET: ""
  ARGUS_FEATURE_FLAG_SERVER_AUTH_TOKEN: ""
