# Copy to terraform.tfvars. Set name, domain and location, pick how traffic reaches Plane, and uncomment anything
# else you want to change. Commented values are the defaults. For objects, set only the fields you change.

name     = "plane"             # never change after install
domain   = "plane.example.com" # never change after install
location = "eastus2"

# subscription_id = "00000000-0000-0000-0000-000000000000" # default: ARM_SUBSCRIPTION_ID or the Azure CLI's

################################################################################
# How traffic reaches Plane: pick ONE block and uncomment it.
# The module configures no DNS. After the apply, create the records shown by:  terraform output dns_records
################################################################################

# Path A: automated. The module installs Traefik (on a static public IP), Plane's routes and the certificates.

# A.1  Let's Encrypt (Plane must be public on port 80; the certificate is issued once your DNS record exists)
# ingress    = { mode = "automated" }
# acme_email = "ops@example.com"
# email      = { certificate_secret_id = "/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.KeyVault/vaults/<vault>/certificates/plane-mail" } # optional; else self-signed

# A.2  Your own certificates, imported into Key Vault before the apply (PEM or PFX, full chain)
# ingress = { mode = "automated", tls_certificate_secret_id = "/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.KeyVault/vaults/<vault>/certificates/plane-web" }
# email   = { certificate_secret_id = "/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.KeyVault/vaults/<vault>/certificates/plane-mail" } # optional; same ID if it covers both names

# Path B: bring your own (default). Nothing to set here. After the apply: install your ingress controller,
# apply Plane's routes, add your certificate and DNS records.

################################################################################
# Everything else (defaults)
################################################################################

# tags = {}

# ingress = {
#   mode                      = "none"            # automated (path A) | none (path B)
#   allowed_cidrs             = ["0.0.0.0/0"]     # path A: who can reach Plane
#   scheme                    = "internet-facing" # path A: or internal (a fixed private IP; not with Let's Encrypt); set at install
#   tls_certificate_secret_id = null              # path A: your web certificate (A.2)
# }
# acme_server     = "https://acme-v02.api.letsencrypt.org/directory" # tests: acme-staging-v02
# tls_secret_name = "plane-tls"

# api_server_authorized_ip_ranges = [] # who can reach the AKS API; empty = everyone
# cluster_admin_object_ids        = [] # Entra ID users/groups/service principals; you are added automatically

