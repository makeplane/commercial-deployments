# Copy to backend.hcl and set your state storage account (private, versioning and soft delete on,
# shared keys off). The identity running Terraform needs Storage Blob Data Contributor on it.
resource_group_name  = "my-tfstate-rg"
storage_account_name = "mytfstate"
container_name       = "tfstate"
key                  = "plane/terraform.tfstate"
use_azuread_auth     = true
